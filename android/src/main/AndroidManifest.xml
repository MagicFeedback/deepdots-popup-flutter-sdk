<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.deepdots.deepdots_popups">
    <!-- The native SDK needs the network, and Flutter adds INTERNET only to debug/profile builds:
         without it a release app gets no popups and 0.7.5 crashes on its first request. -->
    <uses-permission android:name="android.permission.INTERNET"/>
</manifest>
